# Normalizar saltos de línea
* text=auto eol=lf

# Binarios
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.apk binary
*.jar binary
*.jks binary

# Scripts ejecutables
*.sh text eol=lf
gradlew text eol=lf

# Windows
*.bat text eol=crlf
gradlew.bat text eol=crlf

# Evitar diffs de lockfiles
package-lock.json -diff
