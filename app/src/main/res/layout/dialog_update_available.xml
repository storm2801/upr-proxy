<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_update_bg"
    android:elevation="12dp">

    <!-- HERO: cabecera verde con icono -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="28dp"
        android:paddingBottom="22dp"
        android:paddingHorizontal="24dp"
        android:background="@drawable/dialog_update_header_bg">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/circle_white_soft">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_update"
                app:tint="@color/upr_green"
                android:contentDescription="actualizar"/>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Actualización disponible"
            android:textStyle="bold"
            android:textSize="19sp"
            android:textColor="@color/white"
            android:layout_marginTop="14dp"/>

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UPR Proxy tiene una nueva versión lista"
            android:textSize="12sp"
            android:textColor="#D9FFFFFF"
            android:layout_marginTop="4dp"
            android:gravity="center"/>
    </LinearLayout>

    <!-- CUERPO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Comparación de versiones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- Instalada -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/version_box_bg"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INSTALADA"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_text"
                    android:letterSpacing="0.08"/>

                <TextView
                    android:id="@+id/tvCurrentVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.0.0-beta12"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_text"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>

            <!-- Flecha -->
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center_vertical"
                android:layout_marginHorizontal="6dp"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/upr_green_soft"
                android:contentDescription="→"/>

            <!-- Nueva -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/version_box_highlight_bg"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NUEVA"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/upr_green_dark"
                    android:letterSpacing="0.08"/>

                <TextView
                    android:id="@+id/tvNewVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.0.0-beta13"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/upr_green_dark"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Fecha -->
        <TextView
            android:id="@+id/tvPublishDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Publicada el 10 de octubre de 2026"
            android:textSize="11sp"
            android:textColor="@color/gray_text"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"/>

        <!-- Novedades -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOVEDADES"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/upr_green_soft"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvChangelog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="13sp"
            android:textColor="@color/upr_green_dark"
            android:lineSpacingExtra="5dp"
            android:maxLines="10"
            android:ellipsize="end"
            android:background="@drawable/changelog_bg"
            android:padding="14dp"
            android:layout_marginBottom="20dp"/>

        <!-- Botón principal -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdateNow"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Actualizar ahora"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            android:backgroundTint="@color/upr_green"
            android:textColor="@color/white"
            app:elevation="0dp"/>

        <!-- Botón secundario -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdateLater"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:text="Más tarde"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            android:backgroundTint="@android:color/transparent"
            android:textColor="@color/upr_green_soft"
            app:elevation="0dp"/>

    </LinearLayout>
</LinearLayout>
