<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="20dp">

            <ImageView
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:src="@drawable/logo"
                android:contentDescription="@string/university_name"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/university_name"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/upr_green_dark"
                android:layout_marginTop="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/university_subtitle"
                android:textSize="11sp"
                android:textColor="@color/gray_text"/>
        </LinearLayout>

        <!-- Tarjeta de configuración -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white"
            app:strokeColor="@color/upr_green_bg"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/config_title"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/upr_green_dark"
                    android:layout_marginBottom="14dp"/>

                <!-- Servidor -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/server_label"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:startIconDrawable="@drawable/ic_server"
                    app:startIconTint="@color/upr_green_medium"
                    app:boxStrokeColor="@color/upr_green"
                    app:hintTextColor="@color/upr_green_medium"
                    app:boxStrokeWidth="2dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:expandedHintEnabled="false"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editServer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:hint="@string/server_hint"
                        android:textColor="@color/upr_green_dark"
                        android:textColorHint="@color/upr_green_light"
                        android:textSize="14sp"
                        android:importantForAutofill="no"
                        android:saveEnabled="false"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Puerto -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/port_label"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:startIconDrawable="@drawable/ic_port"
                    app:startIconTint="@color/upr_green_medium"
                    app:boxStrokeColor="@color/upr_green"
                    app:hintTextColor="@color/upr_green_medium"
                    app:boxStrokeWidth="2dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:expandedHintEnabled="false"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editPort"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:hint="@string/port_hint"
                        android:textColor="@color/upr_green_dark"
                        android:textColorHint="@color/upr_green_light"
                        android:textSize="14sp"
                        android:importantForAutofill="no"
                        android:saveEnabled="false"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Usuario -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/user_label"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:startIconDrawable="@drawable/ic_person"
                    app:startIconTint="@color/upr_green_medium"
                    app:boxStrokeColor="@color/upr_green"
                    app:hintTextColor="@color/upr_green_medium"
                    app:boxStrokeWidth="2dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:expandedHintEnabled="false"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editUser"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:hint="@string/user_hint"
                        android:textColor="@color/upr_green_dark"
                        android:textColorHint="@color/upr_green_light"
                        android:textSize="14sp"
                        android:importantForAutofill="no"
                        android:saveEnabled="false"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Contraseña -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/password_label"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:startIconTint="@color/upr_green_medium"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/upr_green_medium"
                    app:boxStrokeColor="@color/upr_green"
                    app:hintTextColor="@color/upr_green_medium"
                    app:boxStrokeWidth="2dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:expandedHintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword|textNoSuggestions"
                        android:hint="@string/password_hint"
                        android:textColor="@color/upr_green_dark"
                        android:textColorHint="@color/upr_green_light"
                        android:textSize="14sp"
                        android:importantForAutofill="no"
                        android:saveEnabled="false"/>
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Probar conexión -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTest"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:text="@string/test_connection"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="24dp"
            android:textColor="@color/upr_green_dark"
            app:strokeColor="@color/upr_green"
            app:strokeWidth="2dp"/>

        <!-- Conectar / Desconectar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggle"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:text="@string/connect"
                android:textSize="17sp"
                android:textStyle="bold"
                app:cornerRadius="31dp"
                android:backgroundTint="@color/upr_green"
                android:textColor="@color/white"
                app:elevation="4dp"/>

            <ProgressBar
                android:id="@+id/spinnerToggle"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="24dp"
                android:indeterminateTint="@color/white"
                android:visibility="gone"/>
        </FrameLayout>

        <!-- Tarjeta de estado -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white"
            app:strokeColor="@color/upr_green_bg"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/statusDot"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="@drawable/dot_red"/>

                    <TextView
                        android:id="@+id/txtStatusTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/status_disconnected"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="@color/upr_green_dark"/>
                </LinearLayout>

                <!-- Grid de 2x2 con métricas -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingEnd="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/status_label_server"
                            android:textSize="11sp"
                            android:textColor="@color/gray_text"/>
                        <TextView
                            android:id="@+id/txtStatusServer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/upr_green_dark"
                            android:maxLines="1"
                            android:ellipsize="end"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/status_label_connections"
                            android:textSize="11sp"
                            android:textColor="@color/gray_text"/>
                        <TextView
                            android:id="@+id/txtStatusConnections"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/upr_green_dark"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingEnd="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/status_label_bytes"
                            android:textSize="11sp"
                            android:textColor="@color/gray_text"/>
                        <TextView
                            android:id="@+id/txtStatusBytes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="0 B"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/upr_green_dark"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/status_label_speed"
                            android:textSize="11sp"
                            android:textColor="@color/gray_text"/>
                        <TextView
                            android:id="@+id/txtStatusSpeed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="0 B/s"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/upr_green_dark"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/status_label_uptime"
                        android:textSize="11sp"
                        android:textColor="@color/gray_text"/>
                    <TextView
                        android:id="@+id/txtStatusUptime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/upr_green_dark"/>
                </LinearLayout>

                <!-- Sparkline de velocidad de los últimos 30s -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Actividad de red (últimos 30 s)"
                    android:textSize="11sp"
                    android:textColor="@color/gray_text"/>

                <com.upr.proxy.SparklineView
                    android:id="@+id/sparkline"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/txtVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="Versión 1.0.0-beta9"
            android:textSize="11sp"
            android:textColor="@color/gray_text"
            android:alpha="0.85"/>

    </LinearLayout>
</ScrollView>
