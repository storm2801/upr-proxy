<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Cabecera -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="16dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/logo"
                android:contentDescription="logo"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Menú de desarrollador"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:textColor="@color/upr_green_dark"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Herramientas técnicas UPR"
                    android:textSize="11sp"
                    android:textColor="@color/gray_text"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Estado en vivo -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white"
            app:strokeColor="@color/upr_green_bg"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESTADO ACTUAL"
                    android:textStyle="bold"
                    android:textSize="10sp"
                    android:textColor="@color/upr_green_soft"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:id="@+id/txtDevVpnState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="VPN: desconectada"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="@color/upr_green_dark"/>

                <TextView
                    android:id="@+id/txtDevConns"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Conexiones: 0"
                    android:textSize="12sp"
                    android:textColor="@color/gray_text"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/txtDevBytes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Datos: 0 B"
                    android:textSize="12sp"
                    android:textColor="@color/gray_text"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:id="@+id/txtDevVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Versión: —"
                    android:textSize="12sp"
                    android:textColor="@color/gray_text"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:id="@+id/txtDevDevice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dispositivo: —"
                    android:textSize="12sp"
                    android:textColor="@color/gray_text"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ACTUALIZACIÓN -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ACTUALIZACIÓN"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/upr_green_soft"
            android:letterSpacing="0.1"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="4dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckUpdates"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Buscar actualizaciones"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            android:backgroundTint="@color/upr_green"
            android:textColor="@color/white"
            android:layout_marginBottom="18dp"/>

        <!-- DIAGNÓSTICO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DIAGNÓSTICO"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/upr_green_soft"
            android:letterSpacing="0.1"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="4dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGenerateReport"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="📋  Generar reporte de diagnóstico"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            android:backgroundTint="@color/upr_green"
            android:textColor="@color/white"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewLogs"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Ver logs en vivo"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:strokeColor="@color/upr_green"
            app:strokeWidth="2dp"
            android:backgroundTint="@color/white"
            android:textColor="@color/upr_green_dark"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestConn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Probar conexión al proxy"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:strokeColor="@color/upr_green"
            app:strokeWidth="2dp"
            android:backgroundTint="@color/white"
            android:textColor="@color/upr_green_dark"
            android:layout_marginBottom="8dp"/>

        

        

        <!-- VPN -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VPN"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/upr_green_soft"
            android:letterSpacing="0.1"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="4dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnForceReconnect"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Forzar reconexión"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:strokeColor="@color/upr_green"
            app:strokeWidth="2dp"
            android:backgroundTint="@color/white"
            android:textColor="@color/upr_green_dark"
            android:layout_marginBottom="18dp"/>

        <!-- DATOS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DATOS"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/upr_green_soft"
            android:letterSpacing="0.1"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="4dp"/>

        

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetOnboarding"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Volver a mostrar onboarding"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:strokeColor="@color/upr_green"
            app:strokeWidth="2dp"
            android:backgroundTint="@color/white"
            android:textColor="@color/upr_green_dark"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetPrefs"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Borrar credenciales guardadas"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:strokeColor="#D32F2F"
            app:strokeWidth="2dp"
            android:backgroundTint="@color/white"
            android:textColor="#D32F2F"
            android:layout_marginBottom="22dp"/>

        <!-- Salir -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExitDev"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Salir del modo desarrollador"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            android:backgroundTint="#B71C1C"
            android:textColor="@color/white"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>
